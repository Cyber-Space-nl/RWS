[Unit]
Description=Rust WebServer
Documentation=file:/usr/share/doc/rws/README.md
After=network-online.target php8.3-fpm.service
Wants=network-online.target

[Service]
Type=simple
User=rws
Group=rws
ExecStart=/usr/local/bin/rws --config /etc/rws/config.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
LimitNOFILE=262144
LogsDirectory=rws
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# RestrictSUIDSGID blocks openat2 on Ubuntu 24.04; RWS needs it for safe file access.
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/var/www

[Install]
WantedBy=multi-user.target

